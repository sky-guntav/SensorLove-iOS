#N canvas 120 80 660 620 12;
#X text 20 12 SensorLove in Pure Data: hold the phone up and tilt it. ACCEL's x plays the pitch \, its y the volume. Flat is silent., f 70;
#X text 20 60 SensorLove © 2026 Göktuğ Güntav. Free software under the GNU GPL v3 (LICENSE) \, with the additional terms in ADDITIONAL-TERMS.md., f 70;
#X obj 20 120 netreceive -u -b 9000;
#X obj 20 150 oscparse;
#X obj 20 180 list trim;
#X obj 20 210 route sensorlove;
#X obj 20 240 route accel;
#X obj 20 270 route x y z;
#X floatatom 20 300 6 0 0 0 - - -;
#X floatatom 140 300 6 0 0 0 - - -;
#X obj 20 330 * 12;
#X obj 20 360 + 60;
#X obj 20 390 mtof;
#X msg 20 420 \$1 30;
#X obj 20 450 line~;
#X obj 20 480 osc~;
#X obj 140 330 * -0.2;
#X obj 140 360 clip 0 0.2;
#X msg 140 390 \$1 30;
#X obj 140 420 line~;
#X obj 20 520 *~;
#X obj 20 560 dac~;
#X msg 340 120 \; pd dsp 1;
#X msg 340 160 \; pd dsp 0;
#X text 440 125 audio on;
#X text 440 165 audio off;
#X connect 2 0 3 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 5 0 6 0;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
#X connect 7 1 9 0;
#X connect 8 0 10 0;
